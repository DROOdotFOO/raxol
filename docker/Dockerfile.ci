FROM elixir:1.20.4-otp-29@sha256:c904ce753c35768c76a3be6f16428a83f8237ca0c402355b49bac99d74da2beb

# Install basic dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
  build-essential \
  autoconf \
  m4 \
  libncurses5-dev \
  libssl-dev \
  libgl1-mesa-dev \
  libglu1-mesa-dev \
  libpng-dev \
  openssl \
  git \
  curl \
  wget \
  unzip \
  nodejs \
  npm \
  yarn \
  && rm -rf /var/lib/apt/lists/*

# Set up environment
ENV MIX_HOME=/root/.mix
ENV HEX_HOME=/root/.hex

# Install Hex and Rebar
RUN mix local.hex --force && \
  mix local.rebar --force

WORKDIR /app

CMD ["tail", "-f", "/dev/null"]
