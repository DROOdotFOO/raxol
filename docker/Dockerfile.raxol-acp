# Production image for the raxol_acp settlement solver / accounting sidecar.
#
# A slim, headless release: :raxol_acp + its runtime deps (:raxol_payments,
# :raxol_core, req, cowboy, the rustler_precompiled crypto NIFs). :raxol_agent /
# :raxol_mcp are runtime:false, so :raxol_terminal (the termbox C NIF) is NOT in the
# final release -- though the BUILD still compiles it transitively. Hence the builder
# carries a C toolchain; the runner does not.
#
# The image ALSO bundles the Node signing sidecar (priv/signer_sidecar): in delegated
# (Privy + Alchemy) solver mode the release holds no key and signs by calling that
# sidecar over 127.0.0.1. Its node_modules are installed IN-CONTAINER (sidecar-deps
# stage) so a host macOS/arm64 tree never leaks in; the runner base is a Node image so
# `node` is present to run it. The BEAM supervises the sidecar (Raxol.ACP.SignerSidecar).
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.raxol-acp -t raxol-acp .
#
# No key is BAKED INTO the image. In legacy-EOA solver mode the release reads
# RAXOL_ACP_AGENT_PRIVATE_KEY at runtime; in delegated mode the sidecar reads the P-256
# authorization key (RAXOL_ACP_SIGNER_PRIVATE_KEY) -- both from the runtime env (fly
# secrets), never the image.

ARG ELIXIR_IMAGE=elixir:1.20.0-otp-29
ARG NODE_IMAGE=node:22-bookworm-slim
# The runner is a Node image (same debian bookworm base) so `node` runs the signing
# sidecar; the BEAM's own ERTS ships in the release.
ARG RUNNER_IMAGE=node:22-bookworm-slim

# --- Signing-sidecar deps: install node_modules in-container (never from the host) ---
FROM ${NODE_IMAGE} AS sidecar-deps
WORKDIR /sidecar
COPY packages/raxol_acp/priv/signer_sidecar/package.json \
     packages/raxol_acp/priv/signer_sidecar/package-lock.json ./
RUN npm ci --omit=dev

# --- Elixir builder ---
FROM ${ELIXIR_IMAGE} AS builder

# build-essential + git: termbox2 C NIF (transitive) compiles here; ca-certificates:
# rustler_precompiled downloads prebuilt crypto NIFs over TLS.
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends build-essential git ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

# Bundle the sidecar's in-container node_modules into priv BEFORE `mix release`, so the
# release copies priv/signer_sidecar (server.mjs + node_modules) into its output.
# (.dockerignore excludes any host node_modules, so `COPY . .` above never carried one.)
COPY --from=sidecar-deps /sidecar/node_modules \
     ./packages/raxol_acp/priv/signer_sidecar/node_modules

RUN mix local.hex --force && mix local.rebar --force

ENV MIX_ENV="prod"
# The transitive raxol_terminal build reads this; harmless for the acp release.
ENV SKIP_TERMBOX2_TESTS="true"
ENV TMPDIR="/tmp"

WORKDIR /app/packages/raxol_acp

RUN mix deps.get --only $MIX_ENV
RUN mix deps.compile
RUN mix compile
RUN mix release raxol_acp

# --- Runtime stage: Node base (for the sidecar) + the release's own ERTS ---
FROM ${RUNNER_IMAGE} AS runner

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
      libstdc++6 openssl libncurses6 locales ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

ENV MIX_ENV="prod"

WORKDIR /app
RUN chown nobody /app

COPY --from=builder --chown=nobody:root \
     /app/packages/raxol_acp/_build/prod/rel/raxol_acp ./

USER nobody

ENTRYPOINT ["/app/bin/raxol_acp"]
CMD ["start"]
