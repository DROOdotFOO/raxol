# Production image for the raxol_earn settlement solver / accounting sidecar.
#
# A slim, headless release: :raxol_earn + its runtime deps (:raxol_payments,
# :raxol_core, req, cowboy, the rustler_precompiled crypto NIFs). :raxol_agent /
# :raxol_mcp are runtime:false, so :raxol_terminal (the termbox C NIF) is NOT in the
# final release -- though the BUILD still compiles it transitively. Hence the builder
# carries a C toolchain; the runner does not.
#
# The image ALSO bundles the Node signing sidecar (priv/signer_sidecar): in delegated
# (Privy + Alchemy) solver mode the release holds no key and signs by calling that
# sidecar over 127.0.0.1. Its node_modules are installed IN-CONTAINER (sidecar-deps
# stage) so a host macOS/arm64 tree never leaks in; the runner base is a Node image so
# `node` is present to run it. The BEAM supervises the sidecar (Raxol.Earn.SignerSidecar).
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.raxol-earn -t raxol-earn .
#
# No key is BAKED INTO the image. In legacy-EOA solver mode the release reads
# RAXOL_ACP_AGENT_PRIVATE_KEY at runtime; in delegated mode the sidecar reads the P-256
# authorization key (RAXOL_ACP_SIGNER_PRIVATE_KEY) -- both from the runtime env (fly
# secrets), never the image.

ARG ELIXIR_IMAGE=elixir:1.20.0-otp-29
ARG NODE_IMAGE=node:22-trixie-slim
# The runner is a Node image so `node` runs the signing sidecar; the BEAM's own ERTS
# ships in the release. It MUST be Debian trixie to match ELIXIR_IMAGE's glibc: the
# elixir:1.20-otp-29 builder is trixie (glibc 2.41) and compiles beam.smp against
# GLIBC_2.38+, so a bookworm runner (glibc 2.36) fails at boot with
# "libm.so.6: version `GLIBC_2.38' not found". Keep builder and runner on the same
# Debian release.
ARG RUNNER_IMAGE=node:22-trixie-slim

# --- Signing-sidecar deps: install node_modules in-container (never from the host) ---
FROM ${NODE_IMAGE} AS sidecar-deps
# python3 + toolchain: a transitive optional native module (utf-8-validate via the SDK's
# websocket dep) has no prebuilt binary on some arches and falls back to node-gyp compile.
# Installing the toolchain makes `npm ci` succeed on both amd64 and arm64. This stage is
# discarded -- only node_modules is copied out -- so the tools never reach the final image.
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends python3 make g++ && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /sidecar
COPY packages/raxol_earn/priv/signer_sidecar/package.json \
     packages/raxol_earn/priv/signer_sidecar/package-lock.json ./
RUN npm ci --omit=dev

# --- Elixir builder ---
FROM ${ELIXIR_IMAGE} AS builder

# build-essential + git: termbox2 C NIF (transitive) compiles here; ca-certificates:
# rustler_precompiled downloads prebuilt crypto NIFs over TLS.
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends build-essential git ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

# Bundle the sidecar's in-container node_modules into priv BEFORE `mix release`, so the
# release copies priv/signer_sidecar (server.mjs + node_modules) into its output.
# (.dockerignore excludes any host node_modules, so `COPY . .` above never carried one.)
COPY --from=sidecar-deps /sidecar/node_modules \
     ./packages/raxol_earn/priv/signer_sidecar/node_modules

RUN mix local.hex --force && mix local.rebar --force

ENV MIX_ENV="prod"
# The transitive raxol_terminal build reads this; harmless for the acp release.
ENV SKIP_TERMBOX2_TESTS="true"
ENV TMPDIR="/tmp"

WORKDIR /app/packages/raxol_earn

RUN mix deps.get --only $MIX_ENV
RUN mix deps.compile
RUN mix compile
RUN mix release raxol_earn

# --- Runtime stage: Node base (for the sidecar) + the release's own ERTS ---
FROM ${RUNNER_IMAGE} AS runner

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
      libstdc++6 openssl libncurses6 locales ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

ENV MIX_ENV="prod"

WORKDIR /app
RUN chown nobody /app

COPY --from=builder --chown=nobody:root \
     /app/packages/raxol_earn/_build/prod/rel/raxol_earn ./

USER nobody

ENTRYPOINT ["/app/bin/raxol_earn"]
CMD ["start"]
