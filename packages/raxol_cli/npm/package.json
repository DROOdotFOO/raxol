{
  "name": "raxol",
  "version": "0.2.6",
  "description": "Interactive AI agent and TUI toolkit in your terminal. A self-contained binary (via Burrito), so `npm i -g raxol` puts `raxol` on your PATH -- no Erlang or Elixir required.",
  "bin": {
    "raxol": "bin/launcher.js"
  },
  "files": [
    "bin/"
  ],
  "optionalDependencies": {
    "@raxol/cli-darwin-arm64": "0.2.6",
    "@raxol/cli-linux-x64": "0.2.6",
    "@raxol/cli-linux-arm64": "0.2.6",
    "@raxol/cli-win32-x64": "0.2.6"
  },
  "keywords": [
    "raxol",
    "tui",
    "terminal",
    "ai",
    "agent",
    "elixir"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DROOdotFOO/raxol.git",
    "directory": "packages/raxol_cli/npm"
  }
}
