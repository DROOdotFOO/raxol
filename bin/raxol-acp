#!/bin/sh
# raxol-acp -- serve a Raxol agent over the Agent Client Protocol on stdio from
# a source checkout, for editors that speak ACP (such as Zed). Point the
# editor's agent_servers command at this shim.
#
#   raxol-acp --agent Raxol.Agent.Reference.Counter
#   raxol-acp --agent Raxol.Agent.Reference.Counter:c1
#   raxol-acp --help
#
# The agent's journal is bound to the cwd the editor names in session/new, not
# to the directory this runs from.
#
# Why a shim: Mix prints "Compiling N files" to STDOUT, which would corrupt
# the NDJSON wire. This compiles quietly first, THEN serves, so stdout carries
# only protocol frames.
# Requires deps fetched once: (cd packages/raxol_agent && mix deps.get)

set -e

# shellcheck disable=SC1007  # CDPATH= is an intentional env prefix for a safe cd
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(dirname -- "$SCRIPT_DIR")

cd "$REPO_ROOT/packages/raxol_agent"

# Compile quietly (to stderr) so no build chatter reaches the stdout wire.
# MAKEFLAGS=-s silences the termbox2 NIF make check.
#
# `< /dev/null` matters as much as the stderr redirect: a client writes its
# `initialize` frame as soon as it spawns us, so that frame is already sitting
# in the stdin pipe while this compile runs. Mix boots a full VM whose
# `prim_tty` owns fd 0 and reads ahead, so without this redirect the compile
# step CONSUMES the first frame and discards it on exit -- the client then
# waits forever for a reply to a request the peer never saw. It reproduces as
# a handshake that hangs only when compilation has work to do, which is why it
# looks intermittent.
MAKEFLAGS=-s mix compile >&2 </dev/null || {
  echo "raxol-acp: compile failed; run (cd packages/raxol_agent && mix compile) for details" >&2
  exit 70
}

# Precompiling is not sufficient on its own. A Mix task must load the project
# to be found, and that loadpaths pass announces dep work on STDOUT
# ("==> earmark_parser", "Compiling 47 files") -- elixir_make's NIF check
# re-announces on every invocation, so it is not a first-run-only cost. `mix
# run` is built into Mix, so it parses before any project loadpaths and
# honours --no-deps-check. Nothing is started before `Serve.run/1` has moved
# the log handler to stderr.
#
# No -noinput: the wire is read from the `user` device, which needs stdin.
#
# :code_reloader is off because this runs in :dev: the reloader would
# recompile inside the server when a source file changes and print
# "Compiling N files" on stdout, between frames.
exec env \
  MAKEFLAGS=-s \
  mix run \
    --no-start \
    --no-compile \
    --no-deps-check \
    --no-archives-check \
    --no-elixir-version-check \
    -e 'Application.put_env(:raxol, :skip_endpoint, true)
        Application.put_env(:raxol, :code_reloader, false)
        Application.put_env(:raxol, :startup_mode, :mcp)
        System.halt(Raxol.Agent.ClientProtocol.Serve.run(System.argv()))' \
    -- "$@"
