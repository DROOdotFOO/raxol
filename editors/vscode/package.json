{
  "name": "raxol",
  "displayName": "Raxol Language Support",
  "description": "Language support for Raxol terminal UI framework",
  "version": "1.5.4",
  "publisher": "axol-io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DROOdotFOO/raxol.git"
  },
  "homepage": "https://raxol.io",
  "bugs": {
    "url": "https://github.com/DROOdotFOO/raxol/issues"
  },
  "keywords": [
    "raxol",
    "terminal",
    "ui",
    "elixir"
  ],
  "categories": [
    "Programming Languages",
    "Extension Packs",
    "Snippets"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "activationEvents": [
    "onLanguage:elixir",
    "workspaceContains:mix.exs",
    "workspaceContains:.raxol.exs"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "raxol-elixir",
        "aliases": [
          "Raxol Elixir",
          "raxol"
        ],
        "extensions": [
          ".ex",
          ".exs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "elixir",
        "path": "./snippets/raxol.json"
      }
    ],
    "commands": [
      {
        "command": "raxol.generateComponent",
        "title": "Generate Component",
        "category": "Raxol"
      },
      {
        "command": "raxol.openPlayground",
        "title": "Open Component Playground",
        "category": "Raxol"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "raxol.generateComponent",
          "when": "workspaceContains:mix.exs"
        },
        {
          "command": "raxol.openPlayground",
          "when": "workspaceContains:mix.exs"
        }
      ],
      "explorer/context": [
        {
          "command": "raxol.generateComponent",
          "group": "raxol",
          "when": "explorerResourceIsFolder && workspaceContains:mix.exs"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "20.x",
    "typescript": "^4.9.4"
  }
}
